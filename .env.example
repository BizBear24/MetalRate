# ── Client-side (bundled, must NOT contain secrets) ─────────────────────────
# Base URL the app calls for spot prices. Default: gold-api.com (free, no key).
# If you use a keyed provider, set this to /api/price so requests go through
# the server-side proxy below.
VITE_PRICE_API_URL=https://api.gold-api.com

# Seed the three clearly-labelled demo items on first launch (true/false).
# Set to false before shipping to a real shop.
VITE_SEED_DEMO_DATA=true

# ── Server-side only (never exposed to the browser) ────────────────────────
# Only needed if you switch to a provider that requires a key. The Vite dev /
# preview server proxies /api/price/* -> PRICE_API_BASE_URL and injects the key
# as an x-api-key header. In production, replicate this in your host's
# serverless function / reverse proxy.
PRICE_API_KEY=
PRICE_API_BASE_URL=
